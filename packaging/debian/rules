#!/usr/bin/make -f

export DH_VERBOSE = 1
export PYBUILD_NAME = personnel-availability

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:
	# Тесты выполняются в CI; сборка пакета не запускает pytest.

override_dh_installdesktop:
	dh_installdesktop debian/personnel-availability.desktop
